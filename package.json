{
  "name": "specflow-emulator",
  "version": "2.1.0-alpha.2",
  "description": "A specflow emulator for jest-cucumber, working on jest and vitest",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "default": "./dist/src/browser.js"
    },
    "./vite": {
      "types": "./dist/src/vite.d.ts",
      "default": "./dist/src/vite.js"
    },
    "./feature": {
      "types": "./dist/src/feature.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "browser": [
        "dist/src/browser.d.ts"
      ],
      "vite": [
        "dist/src/vite.d.ts"
      ],
      "feature": [
        "dist/src/feature.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "tslint --project ./",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CroquetMickael/specflow-emulator.git"
  },
  "keywords": [
    "gherkin",
    "specflow",
    "vitest"
  ],
  "author": "David Saffrey",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CroquetMickael/specflow-emulator/issues"
  },
  "homepage": "https://github.com/CroquetMickael/specflow-emulator#readme",
  "dependencies": {
    "@cucumber/gherkin": "28.0.0",
    "callsites": "4.2.0",
    "glob": "13.0.6",
    "jest-cucumber": "4.5.0",
    "kleur": "4.1.5"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^26.4.0",
    "tslint": "6.1.3",
    "typescript": "5.9.3"
  }
}
